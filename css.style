/* General Page Styling */
:root {
    --bg-color: #080808; /* Ultra-dark background */
    --card-bg: #141414; /* Slightly lighter dark for cards */
    --text-main: #ffffff; /* White text */
    --accent-color: #00e676; /* Vibrant Neon Green, like in your image example */
    --shadow-color: rgba(0, 230, 118, 0.3); /* Soft shadow of the neon color */
    --font-main: 'Poppins', sans-serif;
    --font-mono: 'Fira Code', monospace; /* Monospace font for digits and tech vibe */
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    background-color: var(--bg-color);
    color: var(--text-main);
    font-family: var(--font-main);
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    padding: 20px;
}

.main-wrapper {
    width: 100%;
    max-width: 800px;
    text-align: center;
}

/* --- Header Section --- */
.store-header {
    margin-bottom: 50px;
}

.profile-container {
    margin-bottom: 20px;
}

.profile-img {
    width: 150px;
    height: 150px;
    border-radius: 50%; /* Makes it circular */
    object-fit: cover;
    border: 4px solid var(--accent-color); /* Neon border */
    box-shadow: 0 0 25px var(--shadow-color); /* Neon glow */
    /* Add a placeholder style if image isn't found */
    background-color: #333; 
}

.store-name {
    font-size: 3rem;
    text-transform: uppercase;
    letter-spacing: 3px;
    color: var(--text-main);
    text-shadow: 0 0 10px rgba(255, 255, 255, 0.5);
}

/* --- Services Section --- */
.services-section {
    margin-bottom: 60px;
}

.section-title {
    font-size: 1.8rem;
    margin-bottom: 30px;
    color: var(--accent-color);
    text-transform: uppercase;
    letter-spacing: 2px;
}

.services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 20px;
}

.service-card {
    background-color: var(--card-bg);
    padding: 25px;
    border-radius: 12px;
    font-weight: 600;
    text-transform: capitalize;
    transition: all 0.3s ease;
    border: 1px solid transparent;
}

.service-card:hover {
    transform: translateY(-5px);
    border-color: var(--accent-color);
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.5), 0 0 10px var(--shadow-color);
}

/* --- Payment Section --- */
.payment-section {
    margin-bottom: 60px;
}

.payment-container {
    display: flex;
    justify-content: center;
    gap: 30px;
    flex-wrap: wrap;
}

.payment-method {
    background-color: var(--card-bg);
    padding: 20px;
    border-radius: 12px;
    min-width: 280px;
    border-left: 5px solid var(--accent-color); /* Green stripe on the left */
}

.payment-method h3 {
    font-size: 1.2rem;
    margin-bottom: 10px;
    color: #aaaaaa;
}

.payment-detail {
    font-family: var(--font-mono); /* Technical font for numbers */
    font-size: 1.3rem;
    color: var(--text-main);
    letter-spacing: 1px;
}

/* --- Footer Section --- */
.store-footer {
    padding-top: 30px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 0.9rem;
    color: #666666;
}
