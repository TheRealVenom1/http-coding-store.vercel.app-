* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Inter', system-ui, sans-serif;
    background: linear-gradient(135deg, #0a0a0a, #1a1a2e);
    color: #ffffff;
    line-height: 1.6;
    text-align: center;
    min-height: 100vh;
}

header {
    padding: 80px 20px 50px;
}

.logo-container {
    width: 240px;
    height: 240px;
    margin: 0 auto 25px;
    border-radius: 50%;
    overflow: hidden;
    border: 8px solid #00ff9d;
    box-shadow: 0 0 50px rgba(0, 255, 157, 0.6);
    transition: all 0.4s ease;
}

.logo-container:hover {
    transform: scale(1.1) rotate(5deg);
}

.circular-logo {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

h1 {
    font-size: 4rem;
    font-weight: 900;
    background: linear-gradient(90deg, #00ff9d, #00ccff);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    letter-spacing: -2px;
}

.services {
    padding: 60px 20px;
    background: rgba(255,255,255,0.03);
}

.services h2 {
    font-size: 2.8rem;
    margin-bottom: 50px;
    color: #00ff9d;
    font-weight: 700;
}

.services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 30px;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
}

.service-card {
    background: rgba(255,255,255,0.06);
    padding: 35px 25px;
    border-radius: 24px;
    border: 1px solid rgba(0, 255, 157, 0.15);
    transition: all 0.4s ease;
}

.service-card:hover {
    transform: translateY(-20px);
    border-color: #00ff9d;
    box-shadow: 0 25px 50px rgba(0, 255, 157, 0.2);
}

.service-card h3 {
    color: #00ff9d;
    margin-bottom: 15px;
    font-size: 1.75rem;
}

.payment {
    padding: 70px 20px;
    background: #0a0a0a;
}

.payment h2 {
    font-size: 2.8rem;
    margin-bottom: 50px;
    color: #00ccff;
    font-weight: 700;
}

.payment-methods {
    display: flex;
    justify-content: center;
    gap: 60px;
    flex-wrap: wrap;
    max-width: 900px;
    margin: 0 auto;
}

.method {
    background: rgba(0, 204, 255, 0.08);
    padding: 30px 45px;
    border-radius: 20px;
    border: 2px solid #00ccff;
    min-width: 300px;
}

.method h3 {
    color: #00ccff;
    margin-bottom: 12px;
    font-size: 1.6rem;
}

.method p {
    font-size: 1.5rem;
    font-weight: 700;
}

.note {
    margin-top: 40px;
    font-size: 1.15rem;
    color: #bbbbbb;
}

footer {
    padding: 35px;
    background: #000;
    font-size: 1.05rem;
    color: #666;
}

@media (max-width: 768px) {
    .logo-container {
        width: 190px;
        height: 190px;
    }
    h1 {
        font-size: 3rem;
    }
}
