* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

body {
    background: linear-gradient(-45deg, #0f0f0f, #001f2f, #0f0f0f, #002233);
    background-size: 400% 400%;
    animation: bgMove 10s infinite linear;
    color: white;
    text-align: center;
}

/* Background animation */
@keyframes bgMove {
    0% { background-position: 0% 50%; }
    100% { background-position: 100% 50%; }
}

.container {
    padding: 30px;
    animation: fadeIn 1.5s ease;
}

/* Title animation */
.title {
    font-size: 50px;
    margin-bottom: 20px;
    letter-spacing: 4px;
    animation: slideDown 1s ease;
}

/* Image style */
.profile-img {
    width: 180px;
    height: 180px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid cyan;
    box-shadow: 0 0 20px cyan;
    margin-bottom: 25px;
    transition: 0.4s;
}

.profile-img:hover {
    transform: scale(1.1);
    box-shadow: 0 0 40px cyan;
}

/* Box style */
.box {
    background: rgba(255,255,255,0.05);
    margin: 20px auto;
    padding: 20px;
    max-width: 400px;
    border-radius: 15px;
    backdrop-filter: blur(10px);
    transition: 0.4s;
    animation: fadeUp 1s ease;
}

.box:hover {
    transform: translateY(-10px);
    box-shadow: 0 0 25px cyan;
}

h2 {
    margin-bottom: 10px;
}

ul {
    list-style: none;
}

li {
    padding: 10px;
    border-bottom: 1px solid rgba(255,255,255,0.1);
    transition: 0.3s;
}

li:hover {
    color: cyan;
    transform: translateX(5px);
}

/* Footer */
footer {
    margin-top: 40px;
    padding: 15px;
    background: #111;
    font-size: 14px;
    animation: fadeIn 2s ease;
}

/* Animations */
@keyframes fadeIn {
    from {opacity: 0;}
    to {opacity: 1;}
}

@keyframes slideDown {
    from {transform: translateY(-50px); opacity: 0;}
    to {transform: translateY(0); opacity: 1;}
}

@keyframes fadeUp {
    from {transform: translateY(50px); opacity: 0;}
    to {transform: translateY(0); opacity: 1;}
}
