* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Cairo', sans-serif;
    background: #0f0f0f;
    color: #ffffff;
    text-align: center;
    line-height: 1.8;
    padding: 40px 20px;
}

.logo-container {
    width: 220px;
    height: 220px;
    margin: 0 auto 20px;
    border-radius: 50%;
    overflow: hidden;
    border: 6px solid #00ff9d;
    box-shadow: 0 0 30px rgba(0, 255, 157, 0.4);
}

.circular-logo {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

h1 {
    font-size: 3.2rem;
    margin-bottom: 60px;
    color: #00ff9d;
}

h2 {
    font-size: 2.2rem;
    margin: 50px 0 30px;
    color: #ffffff;
}

.services-list {
    max-width: 600px;
    margin: 0 auto;
}

.services-list p {
    font-size: 1.5rem;
    margin: 18px 0;
    padding: 12px;
    background: rgba(255,255,255,0.05);
    border-radius: 12px;
}

.payment-box {
    max-width: 500px;
    margin: 30px auto;
    background: #1a1a1a;
    padding: 40px 30px;
    border-radius: 20px;
    border: 2px solid #00ccff;
}

.payment-box p {
    font-size: 1.4rem;
    margin: 12px 0;
}

.payment-box strong {
    color: #00ff9d;
    font-size: 1.6rem;
}

footer {
    margin-top: 80px;
    padding-top: 30px;
    border-top: 1px solid #333;
    color: #777;
    font-size: 1.1rem;
}

/* Responsive */
@media (max-width: 600px) {
    .logo-container {
        width: 180px;
        height: 180px;
    }
    h1 {
        font-size: 2.6rem;
    }
    h2 {
        font-size: 1.9rem;
    }
}
